# Valeurs fictives : remplacez-les par celles de votre projet Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cle-publique-anon-fictive
# Serveur uniquement. Ne jamais préfixer par NEXT_PUBLIC_.
